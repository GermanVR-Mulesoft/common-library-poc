#%RAML 1.0 DataType
description: Modelo de datos para la actualización parcial de un cliente.
type: object
properties:
  firstName:
    type: string
    required: false
    example: "Luis Germán"
  lastName:
    type: string
    required: false
    example: "Vázquez Rentería"
  email:
    type: string
    required: false
    pattern: "^.+@.+\\..+$"
    example: "german_1241@hotmail.com"
  phone:
    type: string
    required: false
    example: "5550001122"
  status:
    type: string
    required: false
    enum: [ ACTIVE, INACTIVE, SUSPENDED ]
    example: "ACTIVE"